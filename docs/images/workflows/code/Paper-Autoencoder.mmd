

flowchart LR

%%========================
%% Encoder
%%========================
subgraph ENCODER["<b>ENCODER</b>"]
direction TB

A["Input Frame (RGB)<br />(3 x 128 x 128)"]
B["Encoder Stage 1<br />(32 x 64 x 64)"]
C["Encoder Stage 2<br />(64 x 32 x 32)"]
D["Encoder Stage 3<br />(128 x 16 x 16)"]
E["256-D LATENT VECTOR<br />(Compressed Representation)"]

A --> B
B --> C
C --> D
D --> E

end

%%========================
%% Decoder
%%========================
subgraph DECODER["<b>DECODER</b>"]
direction TB

F["Expand & Unflatten<br />(256 --> 128 x 16 x 16)"]
G["Decoder Stage 1<br />(64 x 32 x 32)"]
H["Decoder Stage 2<br />(32 x 64 x 64)"]
I["Decoder Stage 3<br />(3 x 128 x 128)"]
J["Reconstructed Frame<br />(3 x 128 x 128)"]   

F --> G
G --> H
H --> I
I --> J

end

%% Connection between columns
E --> F

